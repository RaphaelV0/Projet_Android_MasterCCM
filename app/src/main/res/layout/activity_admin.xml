<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/geo_background">

    <!-- En-tête bleue dégradée -->
    <View
        android:id="@+id/adminHeaderBg"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:background="@drawable/bg_auth_header"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Logo + titre + déconnexion dans l'en-tête -->
    <LinearLayout
        android:id="@+id/adminHeaderContent"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="24dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_logo_geoevent"
            android:contentDescription="Logo" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GeoEvent"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Panneau d'administration"
                android:textColor="#B3CDEFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Bouton déconnexion -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/adminLogoutButton"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Déconnexion"
            android:textSize="11sp"
            android:textColor="@color/white"
            app:strokeColor="@color/white"
            app:strokeWidth="1dp"
            app:cornerRadius="8dp" />
    </LinearLayout>

    <!-- Carte blanche qui remonte sur l'en-tête (même DA que login) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/adminCard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="110dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="@color/geo_surface"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingTop="20dp">

            <!-- Tab switcher Événements / Notifications -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:background="@drawable/bg_tab_container"
                android:padding="4dp"
                android:layout_marginHorizontal="20dp">

                <TextView
                    android:id="@+id/adminTabEvents"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Événements"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:background="@drawable/bg_tab_selected" />

                <TextView
                    android:id="@+id/adminTabNotifications"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Notifications"
                    android:textSize="13sp"
                    android:textColor="@color/geo_text_secondary"
                    android:background="@android:color/transparent" />
            </LinearLayout>

            <!-- Conteneur des fragments -->
            <FrameLayout
                android:id="@+id/adminFragmentContainer"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="8dp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>