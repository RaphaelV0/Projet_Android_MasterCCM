<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/geo_background">

    <!-- Fond dégradé haut (vague bleue) -->
    <View
        android:id="@+id/headerBackground"
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:background="@drawable/bg_auth_header" />

    <!-- Logo + tagline centrés dans l'en-tête -->
    <LinearLayout
        android:id="@+id/headerContent"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="48dp">

        <ImageView
            android:id="@+id/logoImage"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/ic_logo_geoevent"
            android:contentDescription="Logo GeoEvent" />

        <TextView
            android:id="@+id/appNameText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="GeoEvent"
            android:textSize="28sp"
            android:textStyle="bold"
            android:letterSpacing="0.04"
            android:textColor="@color/white"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/taglineText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Ne manquez plus aucun événement"
            android:textSize="13sp"
            android:textColor="#B3CDEFFF"
            android:letterSpacing="0.02" />
    </LinearLayout>

    <!-- Carte principale (formulaire) -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="200dp"
        android:fillViewport="true">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="0dp"
            app:cardCornerRadius="28dp"
            app:cardElevation="12dp"
            app:cardBackgroundColor="@color/geo_surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="28dp"
                android:paddingTop="32dp"
                android:paddingBottom="40dp">

                <!-- Tab switcher Connexion / Inscription -->
                <LinearLayout
                    android:id="@+id/tabContainer"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_tab_container"
                    android:padding="4dp">

                    <TextView
                        android:id="@+id/tabLogin"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="Connexion"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:background="@drawable/bg_tab_selected" />

                    <TextView
                        android:id="@+id/tabRegister"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="Inscription"
                        android:textSize="14sp"
                        android:textColor="@color/geo_text_secondary"
                        android:background="@android:color/transparent" />
                </LinearLayout>

                <!-- ===== FORMULAIRE CONNEXION ===== -->
                <LinearLayout
                    android:id="@+id/formLogin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="28dp"
                    android:visibility="visible">

                    <!-- Email -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/loginEmailLayout"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Adresse email"
                        app:startIconDrawable="@drawable/ic_email"
                        app:startIconTint="@color/geo_blue_primary"
                        app:boxStrokeColor="@color/geo_blue_primary"
                        app:hintTextColor="@color/geo_text_secondary"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/loginEmailInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textEmailAddress"
                            android:textColor="@color/geo_text_primary"
                            android:textSize="15sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Mot de passe -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/loginPasswordLayout"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:hint="Mot de passe"
                        app:startIconDrawable="@drawable/ic_lock"
                        app:startIconTint="@color/geo_blue_primary"
                        app:passwordToggleEnabled="true"
                        app:passwordToggleTint="@color/geo_text_secondary"
                        app:boxStrokeColor="@color/geo_blue_primary"
                        app:hintTextColor="@color/geo_text_secondary"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/loginPasswordInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword"
                            android:textColor="@color/geo_text_primary"
                            android:textSize="15sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Mot de passe oublié -->
                    <TextView
                        android:id="@+id/forgotPasswordText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_marginTop="10dp"
                        android:text="Mot de passe oublié ?"
                        android:textSize="13sp"
                        android:textColor="@color/geo_orange_primary"
                        android:padding="4dp" />

                    <!-- Message d'erreur -->
                    <TextView
                        android:id="@+id/loginErrorText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text=""
                        android:textSize="13sp"
                        android:textColor="@color/geo_error"
                        android:gravity="center"
                        android:visibility="gone" />

                    <!-- Bouton Se connecter -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/loginButton"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="24dp"
                        android:text="Se connecter"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:letterSpacing="0.04"
                        app:backgroundTint="@color/geo_orange_primary"
                        app:cornerRadius="14dp"
                        app:elevation="4dp" />

                    <!-- Séparateur OU -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1"
                            android:background="@color/geo_divider" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ou"
                            android:textSize="13sp"
                            android:textColor="@color/geo_text_hint"
                            android:paddingHorizontal="14dp" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1"
                            android:background="@color/geo_divider" />
                    </LinearLayout>

                    <!-- Bouton Google (stub UI) -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/loginGoogleButton"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="16dp"
                        android:text="Continuer avec Google"
                        android:textSize="15sp"
                        android:textColor="@color/geo_text_primary"
                        app:strokeColor="@color/geo_border"
                        app:strokeWidth="1.5dp"
                        app:cornerRadius="14dp"
                        app:icon="@drawable/ic_google"
                        app:iconGravity="start"
                        app:iconTint="@null" />
                </LinearLayout>

                <!-- ===== FORMULAIRE INSCRIPTION ===== -->
                <LinearLayout
                    android:id="@+id/formRegister"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="28dp"
                    android:visibility="gone">

                    <!-- Prénom + Nom côte à côte -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/registerFirstNameLayout"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:hint="Prénom"
                            app:boxStrokeColor="@color/geo_blue_primary"
                            app:hintTextColor="@color/geo_text_secondary"
                            app:boxCornerRadiusTopStart="12dp"
                            app:boxCornerRadiusTopEnd="12dp"
                            app:boxCornerRadiusBottomStart="12dp"
                            app:boxCornerRadiusBottomEnd="12dp">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/registerFirstNameInput"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textPersonName"
                                android:textColor="@color/geo_text_primary"
                                android:textSize="15sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/registerLastNameLayout"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:hint="Nom"
                            app:boxStrokeColor="@color/geo_blue_primary"
                            app:hintTextColor="@color/geo_text_secondary"
                            app:boxCornerRadiusTopStart="12dp"
                            app:boxCornerRadiusTopEnd="12dp"
                            app:boxCornerRadiusBottomStart="12dp"
                            app:boxCornerRadiusBottomEnd="12dp">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/registerLastNameInput"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textPersonName"
                                android:textColor="@color/geo_text_primary"
                                android:textSize="15sp" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <!-- Email -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/registerEmailLayout"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:hint="Adresse email"
                        app:startIconDrawable="@drawable/ic_email"
                        app:startIconTint="@color/geo_blue_primary"
                        app:boxStrokeColor="@color/geo_blue_primary"
                        app:hintTextColor="@color/geo_text_secondary"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/registerEmailInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textEmailAddress"
                            android:textColor="@color/geo_text_primary"
                            android:textSize="15sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Mot de passe -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/registerPasswordLayout"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:hint="Mot de passe"
                        app:startIconDrawable="@drawable/ic_lock"
                        app:startIconTint="@color/geo_blue_primary"
                        app:passwordToggleEnabled="true"
                        app:passwordToggleTint="@color/geo_text_secondary"
                        app:boxStrokeColor="@color/geo_blue_primary"
                        app:hintTextColor="@color/geo_text_secondary"
                        app:helperText="8 caractères minimum"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/registerPasswordInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword"
                            android:textColor="@color/geo_text_primary"
                            android:textSize="15sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Confirmer mot de passe -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/registerConfirmPasswordLayout"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:hint="Confirmer le mot de passe"
                        app:startIconDrawable="@drawable/ic_lock"
                        app:startIconTint="@color/geo_blue_primary"
                        app:passwordToggleEnabled="true"
                        app:passwordToggleTint="@color/geo_text_secondary"
                        app:boxStrokeColor="@color/geo_blue_primary"
                        app:hintTextColor="@color/geo_text_secondary"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/registerConfirmPasswordInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword"
                            android:textColor="@color/geo_text_primary"
                            android:textSize="15sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Message d'erreur inscription -->
                    <TextView
                        android:id="@+id/registerErrorText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text=""
                        android:textSize="13sp"
                        android:textColor="@color/geo_error"
                        android:gravity="center"
                        android:visibility="gone" />

                    <!-- Bouton S'inscrire -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/registerButton"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="24dp"
                        android:text="Créer mon compte"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:letterSpacing="0.04"
                        app:backgroundTint="@color/geo_orange_primary"
                        app:cornerRadius="14dp"
                        app:elevation="4dp" />

                    <!-- CGU -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="En créant un compte, vous acceptez nos Conditions d'utilisation."
                        android:textSize="11sp"
                        android:textColor="@color/geo_text_hint"
                        android:gravity="center"
                        android:lineSpacingExtra="2dp" />
                </LinearLayout>

                <!-- Indicateur de chargement -->
                <ProgressBar
                    android:id="@+id/loadingIndicator"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="16dp"
                    android:indeterminateTint="@color/geo_orange_primary"
                    android:visibility="gone" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>