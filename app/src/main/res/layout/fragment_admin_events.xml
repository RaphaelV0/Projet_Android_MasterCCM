<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Barre de recherche + tri -->
    <LinearLayout
        android:id="@+id/adminSearchBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Champ de recherche -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Rechercher par titre ou lieu…"
            app:startIconDrawable="@android:drawable/ic_menu_search"
            app:startIconTint="@color/geo_blue_primary"
            app:boxStrokeColor="@color/geo_blue_primary"
            app:hintTextColor="@color/geo_text_secondary"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/adminSearchInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:textColor="@color/geo_text_primary"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Spinner de tri -->
        <Spinner
            android:id="@+id/adminSortSpinner"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_tab_container"
            android:paddingHorizontal="12dp"
            android:spinnerMode="dropdown" />
    </LinearLayout>

    <!-- Liste des événements -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/adminEventsRecycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingBottom="80dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/adminSearchBar"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- État vide -->
    <TextView
        android:id="@+id/adminEmptyState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Aucun événement trouvé"
        android:textSize="15sp"
        android:textColor="@color/geo_text_hint"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- FAB Ajouter -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAdminAddEvent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:contentDescription="Ajouter un événement"
        android:backgroundTint="@color/geo_orange_primary"
        app:srcCompat="@android:drawable/ic_input_add"
        app:tint="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>