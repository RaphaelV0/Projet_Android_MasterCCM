<?xml version="1.0" encoding="utf-8"?>
<!--
    Fond dégradé de l'en-tête d'authentification.
    Du bleu foncé GeoEvent vers un bleu moyen,
    avec une forme arrondie en bas pour l'effet "vague".
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <gradient
        android:type="linear"
        android:angle="160"
        android:startColor="#0D2B5E"
        android:centerColor="#1A4A8A"
        android:endColor="#2563B0" />

    <corners
        android:bottomLeftRadius="36dp"
        android:bottomRightRadius="36dp" />
</shape>